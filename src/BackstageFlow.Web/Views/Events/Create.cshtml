@model Event
@{
    ViewData["Title"] = "Novo evento";
    ViewData["PageTitle"] = "Cadastrar evento";
}
<form method="post" class="panel form-panel">
    <div class="panel-header"><div><span class="eyebrow">NOVO EVENTO</span><h2>Informações gerais</h2></div></div>
    <partial name="_Form" model="Model" />
    <div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancelar</a><button class="button button-primary" type="submit">Salvar evento</button></div>
</form>
